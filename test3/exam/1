class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        int cnt = 0;
        for (int i = 0; i < nums.length; i++) {
            for (int j = i; j < nums.length; j++) {
                int s = sum(nums, i, j);
                // if (s < 0) {
                // continue;
                // }
                if (s % k == 0) {
                    cnt++;
                }
            }
        }
        return cnt;

    }

    private int sum(int[] nums, int start, int end) {
        int s = 0;
        for (int i = start; i <= end; i++) {
            s += nums[i];
        }
        return s;
    }
}